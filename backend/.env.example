# =============================================================================
# MIP · variables de entorno del backend
#
# Copie este archivo a .env y ajuste. Las variables sin valor por defecto se
# validan al arranque (src/config/env.validation.ts): si falta una, el proceso
# NO levanta y dice cuál. Es deliberado: preferimos fallar al arrancar que
# descubrir a medianoche que el correo nunca se envió.
# =============================================================================

# ── Aplicación ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3200
API_PREFIX=api
# Zona horaria por defecto. La real la define cada tenant (cap. 5, regla 23.1).
TZ=America/Lima

# ── Base de datos ────────────────────────────────────────────────────────────
# El usuario del backend es mip_app_user y SÓLO tiene EXECUTE sobre el schema
# `app`. Si aquí pone el superusuario de Postgres, se salta el modelo de
# seguridad completo del proyecto: no lo haga fuera de desarrollo.
DATABASE_URL=postgresql://mip_app_user:cambiar_en_deploy@localhost:5436/mip_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── JWT ──────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres cada uno; la validación de arranque lo comprueba.
# Genere con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiar_esto_por_un_secreto_largo_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambiar_esto_por_otro_secreto_largo_de_al_menos_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=mip
JWT_AUDIENCE=mip-app

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECRET=cambiar_esto_minimo_16_chars

# ── Redis ────────────────────────────────────────────────────────────────────
# Se usa para la whitelist de refresh tokens (por `jti`). Si Redis no está
# disponible, el login sigue funcionando pero el refresh no puede revocarse.
REDIS_URL=redis://localhost:6383
REDIS_PREFIX=mip:

# ── Almacenamiento de adjuntos (MinIO / S3) ─────────────────────────────────
# Los límites de tamaño NO se configuran aquí: viven en la base, por tenant
# (core.tenant_configuracion, clave limites_adjunto), porque el cap. 28.3 dice
# que deben poder cambiarse sin tocar la lógica.
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9110
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=mip-adjuntos
STORAGE_REGION=us-east-1
# Minutos de validez de las URL prefirmadas de descarga.
STORAGE_URL_TTL_MIN=15

# ── Correo ───────────────────────────────────────────────────────────────────
# El correo es una COPIA de la notificación interna, nunca la fuente de verdad
# (cap. 34.1). Si el envío falla, la operación de negocio NO se revierte: el
# fallo queda registrado en core.notificacion.error_envio para soporte.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MIP <no-reply@mip.local>"
# Si está vacío, el módulo de correo arranca en modo inerte y sólo registra.
MAIL_ENABLED=false

# ── Seguridad ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL_MS=60000
# Tamaño máximo del cuerpo de una petición, en bytes (subida de adjuntos).
BODY_LIMIT_BYTES=52428800

# ── Observabilidad ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
# En desarrollo, formatea el log con pino-pretty. En producción déjelo en false:
# el JSON crudo es lo que consumen los agregadores.
LOG_PRETTY=true

# ── SAP ──────────────────────────────────────────────────────────────────────
# NO HAY CONECTOR. El cap. 22.4 deja pendientes los campos de SOLPED, la versión
# de SAP por cliente, las APIs y las autorizaciones; el cap. 38 prohíbe
# resolverlo con un supuesto de desarrollador.
#
# El flujo funciona en modo manual: se prepara la SOLPED, se marca lista y se
# captura el número SAP a mano. Estas variables quedan reservadas para cuando
# el cliente defina su entorno.
SAP_ENABLED=false
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
